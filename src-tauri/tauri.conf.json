{
	"$schema": "https://schema.tauri.app/config/2",
	"productName": "tri.scrnz",
	"version": "1.0.0",
	"identifier": "io.github.rddolor27.tri-scrnz",
	"build": {
		"beforeDevCommand": "pnpm dev",
		"devUrl": "http://localhost:1420",
		"beforeBuildCommand": "pnpm build",
		"frontendDist": "../dist"
	},
	"app": {
		"windows": [
			{
				"label": "main",
				"title": "tri.scrnz",
				"width": 1440,
				"height": 900,
				"minWidth": 960,
				"minHeight": 600,
				"center": true,
				"theme": "Dark"
			}
		],
		"security": {
			"csp": {
				"default-src": "'self'",
				"connect-src": "ipc: http://ipc.localhost ws://127.0.0.1:*",
				"worker-src": "'self' blob:",
				"img-src": "'self' blob: data:",
				"style-src": "'self' 'unsafe-inline'"
			}
		}
	},
	"bundle": {
		"active": true,
		"targets": ["nsis"],
		"icon": [
			"icons/32x32.png",
			"icons/128x128.png",
			"icons/128x128@2x.png",
			"icons/icon.icns",
			"icons/icon.ico"
		],
		"resources": {
			"resources/scrcpy-server-v5.0.1": "scrcpy-server-v5.0.1",
			"../LICENSE": "LICENSE",
			"../NOTICE": "NOTICE"
		}
	}
}
